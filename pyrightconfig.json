{
  "include": [
    "identity/src",
    "identity/tests",
    "notification/src",
    "notification/tests",
    "store/src",
    "store/tests",
    "examples/identity_notification_consumer/src",
    "examples/identity_notification_consumer/tests",
    "examples/identity_store_consumer/src",
    "examples/identity_store_consumer/tests",
    "examples/identity_store_consumer/migrations"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "executionEnvironments": [
    {
      "root": "identity",
      "extraPaths": [
        "identity/src",
        "notification/src"
      ]
    },
    {
      "root": "notification",
      "extraPaths": [
        "notification/src"
      ]
    },
    {
      "root": "store",
      "extraPaths": [
        "store/src"
      ]
    },
    {
      "root": "examples/identity_notification_consumer",
      "extraPaths": [
        "examples/identity_notification_consumer/src",
        "identity/src",
        "notification/src"
      ]
    },
    {
      "root": "examples/identity_store_consumer",
      "extraPaths": [
        "examples/identity_store_consumer/src",
        "identity/src",
        "notification/src",
        "store/src"
      ]
    }
  ]
}
